{
  "name": "changping-jingkao-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:run": "node --test --test-concurrency=1 test/*.test.js",
    "data:build": "python3 scripts/build_data.py",
    "data:check": "python3 scripts/validate_data.py",
    "data:refresh": "bash scripts/rebuild_data.sh",
    "national:import": "python3 scripts/national/import_positions.py",
    "national:check": "python3 scripts/national/validate_positions.py",
    "national:test": "python3 tests/test_national_import.py && python3 tests/test_national_validate.py"
  }
}
